<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Stampa Cambi Serie - Gestionale OMG</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 12pt; color: #000; margin: 20px; }
        h2 { text-align: center; margin-bottom: 5px; }
        .subtitle { text-align: center; font-size: 10pt; color: #555; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #333; padding: 6px 8px; text-align: left; font-size: 10pt; }
        th { background-color: #f2f2f2; }
        .text-center { text-align: center; }
        @media print {
            .no-print { display: none; }
            body { margin: 0; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="no-print" style="text-align: right; margin-bottom: 15px;">
        <button onclick="window.print()" style="padding: 10px 20px; background: #0d6efd; color: white; border: none; border-radius: 4px; cursor: pointer;">Stampa / Salva PDF</button>
        <button onclick="window.history.back()" style="padding: 10px 20px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;">Indietro</button>
    </div>

    <h2>GESTIONALE OMG - REPORT CAMBI SERIE SELEZIONATI</h2>
    <div class="subtitle">Stampato in data: <script>document.write(new Date().toLocaleDateString('it-IT'))</script></div>

    <table>
        <thead>
            <tr>
                <th>Data</th>
                <th>Forno / Linea</th>
                <th>Bottiglia Smontante</th>
                <th>Bottiglia Montante</th>
                <th class="text-center">Tempo</th>
                <th class="text-center">Tempera</th>
                <th class="text-center">Piastrina</th>
                <th class="text-center">Diametro</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            {% for r in record_serie %}
            <tr>
                <td>{{ r.data_cambio }}</td>
                <td><strong>{{ r.forno }}</strong> (Lin. {{ r.linea }})</td>
                <td>{{ r.bottiglia_precedente or r.nome_bottiglia }}</td>
                <td><strong>{{ r.bottiglia_nuova }}</strong></td>
                <td class="text-center">{{ r.tempo_cambio }}</td>
                <td class="text-center">
                    {% if r.num_bottiglie_tempera_nuova is not none %}
                        {{ r.num_bottiglie_tempera_nuova }}
                    {% else %}
                        {{ r.num_bottiglie_tempera or 0 }}
                    {% endif %}
                </td>
                <td class="text-center">{{ r.misura_piastrina_nuova or r.misura_piastrina or '-' }}</td>
                <td class="text-center">{{ r.diametro_bottiglia_nuova or r.diametro_bottiglia or '-' }}</td>
                <td>{{ r.note or '' }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="9" class="text-center">Nessun cambio serie selezionato.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
