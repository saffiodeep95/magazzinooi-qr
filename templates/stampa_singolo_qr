<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stampa QR - {{ prodotto.nome }}</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        body { font-family: sans-serif; padding: 20px; background: white; text-align: center; }
        .no-print { margin-bottom: 20px; }
        .btn { background: #4f46e5; color: white; padding: 10px 16px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; text-decoration: none; }
        
        .qr-card {
            border: 2px solid #000;
            padding: 15px;
            display: inline-block;
            border-radius: 8px;
            text-align: center;
            max-width: 220px;
        }
        .qr-card h3 { margin: 5px 0; font-size: 1.1rem; }
        .qr-card p { margin: 4px 0; font-size: 0.85rem; color: #333; }
        .qrcode-container { display: flex; justify-content: center; margin: 10px 0; }

        @media print {
            .no-print { display: none; }
            body { padding: 0; }
        }
    </style>
</head>
<body>

    <div class="no-print">
        <button onclick="window.print()" class="btn" style="background: #10b981;">🖨️ Stampa Etichetta</button>
        <a href="{{ url_for('gestisci_prodotto', qr_code=prodotto.qr_code) }}" class="btn" style="background: #64748b;">← Torna alla Gestione</a>
    </div>

    <div class="qr-card">
        <h3>{{ prodotto.nome }}</h3>
        <div class="qrcode-container" id="qrcode"></div>
        <p><strong>QR:</strong> <code>{{ prodotto.qr_code }}</code></p>
        {% if prodotto.sap %}<p><strong>SAP:</strong> {{ prodotto.sap }}</p>{% endif %}
        <p style="font-weight: bold; color: #2563eb;">📍 {{ prodotto.posizione if prodotto.posizione else 'Nessuna posizione' }}</p>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let code = "{{ prodotto.qr_code }}";
            if(code) {
                new QRCode(document.getElementById("qrcode"), {
                    text: code,
                    width: 130,
                    height: 130,
                    colorDark: "#000000",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.H
                });
            }
        });
    </script>
</body>
</html>
